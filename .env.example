# Keep real values out of Git and chat. Configure these through Vercel.
MONGO_URI=mongodb://localhost:27017/dnd_site
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
APP_ORIGIN=http://localhost:5173
SRD_API_URL=http://localhost:3000/api/2014
# Optional derived pack preparation, restricted to the prepared-reader scope.
COMPENDIUM_READER=legacy
COMPENDIUM_PREPARED_USERS=
COMPENDIUM_PACK_PREPARATION=off
# Enable only after shared notebook writers are deployed and rooms are certified.
NOTEBOOK_DB_LISTING=off
# Blank admits no rooms. Start with a certified canary room before considering '*'.
NOTEBOOK_DB_ROOMS=
